{
  "name": "cancun",
  "productName": "Cancun",
  "version": "0.1.0",
  "description": "Editor de video de escritorio con CLI para Claude",
  "main": "out/main/index.js",
  "type": "module",
  "bin": {
    "cancun": "cli/cancun.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "mp4box": "^0.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "Daniel Anchicoque Martínez",
  "license": "MIT",
  "homepage": "https://github.com/danielanchicoque-cpu/cancun",
  "repository": { "type": "git", "url": "git+https://github.com/danielanchicoque-cpu/cancun.git" },
  "build": {
    "appId": "com.daniel.cancun",
    "productName": "Cancun",
    "copyright": "Copyright (c) 2026 Daniel Anchicoque Martínez",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "vendor/**/*",
      "resources/**/*",
      "cli/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "vendor/**",
      "resources/**",
      "node_modules/@mediapipe/tasks-vision/wasm/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cancun",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Cancun-Instalador-${version}.${ext}",
      "language": "3082"
    }
  }
}
